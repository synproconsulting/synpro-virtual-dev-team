# ================================================================================================
# SynPro Virtual Dev Team - Backend Environment Configuration
# ================================================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env file to version control!
#
# Documentation:
# - CORS Configuration: docs/CORS_CONFIGURATION.md
# - JWT Configuration: docs/JWT_CONFIGURATION.md (SDT1-63)
# - Deployment Guide: docs/DEPLOYMENT_CHECKLIST.md
# ================================================================================================

# ── Core Settings ──────────────────────────────────────────────────────────────────────────────

# Environment type: development, staging, production
# Default: production
ENVIRONMENT=development

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Development: DEBUG, Production: INFO
LOG_LEVEL=INFO


# ── CORS Configuration (SDT1-56) ──────────────────────────────────────────────────────────────

# Frontend URL(s) - Single URL or comma-separated list
# Examples:
#   Single:   FRONTEND_URL=https://app.example.com
#   Multiple: FRONTEND_URL=https://app.example.com,https://admin.example.com
#   Wildcard: FRONTEND_URL=* (requires ALLOW_CORS_WILDCARD=true)
#
# Development default (if not set): http://localhost:3000
# Production: REQUIRED - must be explicitly set
FRONTEND_URL=http://localhost:3000

# Allow wildcard '*' origin (true/false)
# WARNING: Only use in development or for public APIs
# Default: false
ALLOW_CORS_WILDCARD=false


# ── JWT Configuration (SDT1-63) ───────────────────────────────────────────────────────────────

# JWT secret key for token signing
# CRITICAL: Generate a secure secret for production!
#
# Generate with: python -c "from config import generate_jwt_secret; print(generate_jwt_secret())"
#
# Development: Can use any value (auto-generated if not set)
# Production: REQUIRED - must be cryptographically secure (32+ chars, high entropy)
JWT_SECRET=dev-secret-change-in-production

# JWT token expiry in hours
# Default: 24 hours
JWT_EXPIRY_HOURS=24

# Allow weak JWT secrets in development (true/false)
# Default: false
ALLOW_WEAK_JWT_SECRET=false


# ── Database ──────────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection URL
# Format: postgresql://username:password@hostname:port/database
# Example: postgresql://user:pass@localhost:5432/synpro_uat
#
# For SSL: Add ?sslmode=require
# Example: postgresql://user:pass@host:5432/db?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/synpro_uat


# ── Jira Integration ──────────────────────────────────────────────────────────────────────────

# Jira API token (generate at https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_API_TOKEN=your-jira-api-token

# Jira account email
JIRA_EMAIL=your-email@example.com

# Jira server URL (include https://)
JIRA_SERVER=https://yourcompany.atlassian.net

# Jira project key (e.g., SDT1)
JIRA_PROJECT_KEY=SDT1


# ── GitHub Integration ────────────────────────────────────────────────────────────────────────

# GitHub personal access token
# Permissions needed: repo (full control)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=your-github-token

# GitHub repository (format: owner/repo)
GITHUB_REPO=your-org/your-repo


# ── Railway Integration (Optional) ────────────────────────────────────────────────────────────

# Railway API token (for deployment automation)
# Generate at: https://railway.app/account/tokens
RAILWAY_TOKEN=your-railway-token


# ── SonarCloud Integration (Optional) ─────────────────────────────────────────────────────────

# SonarCloud API token
# Generate at: https://sonarcloud.io/account/security
SONARCLOUD_TOKEN=your-sonarcloud-token

# SonarCloud organization
SONARCLOUD_ORGANIZATION=your-sonarcloud-org


# ── Rate Limiting (Optional) ──────────────────────────────────────────────────────────────────

# Rate limit storage backend: memory, redis
# Default: memory
RATE_LIMIT_STORAGE=memory

# Redis URL for rate limiting (if using redis backend)
# REDIS_URL=redis://localhost:6379/0


# ── Email/Notifications (Optional) ────────────────────────────────────────────────────────────

# SMTP settings for email notifications
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@example.com


# ── Additional Settings ───────────────────────────────────────────────────────────────────────

# Add any additional environment variables your application needs below
# ...


# ================================================================================================
# SECURITY NOTES
# ================================================================================================
#
# 1. NEVER commit this file with real credentials to version control
# 2. Use strong, unique secrets for JWT_SECRET in production
# 3. Use HTTPS URLs for FRONTEND_URL in production
# 4. Restrict CORS to specific domains (avoid wildcard in production)
# 5. Store production secrets in a secure secret manager (AWS Secrets Manager, Vault, etc.)
# 6. Rotate secrets regularly
# 7. Use different secrets for each environment (dev, staging, production)
#
# ================================================================================================
