# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
FROM_EMAIL=noreply@yourapp.com

# Application URLs
PASSWORD_RESET_URL=https://yourapp.com/reset-password

# CORS Configuration
# Comma-separated list of allowed frontend origins
# Production example: FRONTEND_URL=https://app.example.com,https://admin.example.com
# Development: Leave empty to default to localhost origins, or specify custom URLs
# IMPORTANT: Never use "*" in production - specify explicit URLs for security
FRONTEND_URL=https://app.example.com

# Environment
# Valid values: development, staging, production
# Controls CORS validation strictness and default behaviors
ENVIRONMENT=development

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Rate Limiting
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_STORAGE_URI=memory://

# Logging
LOG_LEVEL=INFO
