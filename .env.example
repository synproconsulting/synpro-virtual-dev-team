# Environment Configuration
# Copy this file to .env and fill in your values

# Environment Type
# Set to 'development' or 'production' (default: production)
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# JWT Configuration (SDT1-63: Hardened JWT secret handling)
# Generate a secure secret with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# REQUIRED in production, auto-generated in development if not set
JWT_SECRET=your-secure-jwt-secret-here-use-32-bytes-minimum

# JWT token expiry in hours (default: 24)
JWT_EXPIRY_HOURS=24

# JWT algorithm (default: HS256, allowed: HS256, HS384, HS512)
JWT_ALGORITHM=HS256

# Optional: Old JWT secret for key rotation
# When rotating keys, set this to your old secret to allow tokens signed with
# the old key to still be validated during the transition period
# JWT_SECRET_OLD=your-old-jwt-secret

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
FROM_EMAIL=noreply@yourapp.com

# Application URLs
PASSWORD_RESET_URL=https://yourapp.com/reset-password

# CORS Configuration (SDT1-56: Hardened CORS)
# Single origin or comma-separated list
FRONTEND_URL=http://localhost:3000,http://localhost:5173

# Set to 'true' to explicitly allow wildcard CORS (not recommended for production)
ALLOW_CORS_WILDCARD=false
