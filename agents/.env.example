# Cap Manager Agent Configuration

# Maximum number of retrigger attempts per ticket before escalation
# Default: 3
MAX_RETRIGGER_ATTEMPTS=3

# Time window in minutes for counting retrigger attempts
# After this window expires, the retrigger count resets
# Default: 60 (1 hour)
RETRIGGER_WINDOW_MINUTES=60

# Logging configuration
LOG_LEVEL=INFO
