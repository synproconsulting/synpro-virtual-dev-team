# Control Centre Frontend Environment Variables
# Copy this file to .env and fill in your values

# ── Backend API Configuration ─────────────────────────────────────────────────────────
# Base URL for the UAT backend API
VITE_API_BASE_URL=http://localhost:8000

# ── GitHub API Configuration ──────────────────────────────────────────────────────────
# GitHub API Token (optional but recommended for higher rate limits)
# Create a Personal Access Token at: https://github.com/settings/tokens
# Required scopes: repo, workflow
REACT_APP_GITHUB_TOKEN=your_github_personal_access_token_here

# Default repository to monitor (format: owner/repo)
REACT_APP_DEFAULT_GITHUB_REPO=facebook/react

# API polling interval in milliseconds (default: 30000 = 30 seconds)
REACT_APP_POLLING_INTERVAL=30000

# ── Railway Configuration ─────────────────────────────────────────────────────────────
# SDT1-58: Railway project ID for UAT Deploy tab
# Get this from your Railway project settings
VITE_RAILWAY_PROJECT_ID=your-railway-project-id-here
