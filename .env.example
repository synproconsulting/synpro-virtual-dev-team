# Environment
ENVIRONMENT=development  # or 'production'

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# JWT Configuration (SDT1-63: Hardened JWT secret key handling)
# Generate a secure secret with: python scripts/generate_secrets.py --type jwt
# REQUIRED in production, optional in development (auto-generated if not set)
JWT_SECRET=your-secure-random-jwt-secret-at-least-32-characters
JWT_EXPIRY_HOURS=24
JWT_ALGORITHM=HS256

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
FROM_EMAIL=noreply@yourapp.com

# Application URLs
PASSWORD_RESET_URL=https://yourapp.com/reset-password
FRONTEND_URL=http://localhost:3000

# Railway API Configuration (SDT1-58)
# Get your API token from: https://railway.app/account/tokens
RAILWAY_API_TOKEN=your-railway-api-token-here
RAILWAY_PROJECT_ID=your-default-project-id  # Optional: Default project to use

# Jira API Configuration
# Get your API token from: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your-jira-api-token-here
JIRA_EMAIL=your-jira-email@example.com
JIRA_DOMAIN=yourcompany.atlassian.net

# Token Rotation Configuration (SDT1-70)
# Webhook URL for rotation notifications (Slack, Discord, etc.)
ROTATION_NOTIFICATION_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# Email for rotation notifications
ROTATION_NOTIFICATION_EMAIL=security@yourcompany.com

# Security Settings
# WARNING: Only use these in development/testing, never in production!
# ALLOW_INSECURE_JWT_SECRET=false  # Set to 'true' to bypass JWT secret validation (NOT RECOMMENDED)
# ALLOW_CORS_WILDCARD=false        # Set to 'true' to allow CORS wildcard '*' (NOT RECOMMENDED)
