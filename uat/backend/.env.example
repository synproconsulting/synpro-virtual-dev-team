# UAT Backend Environment Variables
# Copy this file to .env and fill in your values

# ── Database Configuration ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ── Frontend Configuration (CORS) ─────────────────────────────────────────────────────
# Single frontend URL
FRONTEND_URL=http://localhost:3000

# Multiple frontend URLs (comma-separated)
# FRONTEND_URL=https://app.example.com,https://admin.example.com,https://staging.example.com

# Development wildcard (NOT RECOMMENDED for production)
# FRONTEND_URL=*
# ALLOW_CORS_WILDCARD=true

# Environment: development or production (default: production)
# In production, wildcard CORS requires ALLOW_CORS_WILDCARD=true
ENVIRONMENT=development

# ── Rate Limiting Configuration ───────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_STORAGE_URI=memory://
# For production, use Redis:
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379

# ── Logging Configuration ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── JWT Configuration ─────────────────────────────────────────────────────────────────
JWT_SECRET=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# ── SMTP Email Configuration ──────────────────────────────────────────────────────────
# For password reset emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=SynPro Virtual Dev Team
