# JWT Configuration (REQUIRED - SDT1-63: Hardened JWT handling)
# Generate a secure secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Minimum 32 characters, cryptographically random
JWT_SECRET=CHANGE_ME_GENERATE_WITH_SECRETS_TOKEN_URLSAFE_32
JWT_EXPIRY_HOURS=24

# JWT Key Rotation (Optional - for zero-downtime key updates)
# Comma-separated list of old secrets that should still be accepted
# JWT_SECRET_OLD=old_secret_1,old_secret_2

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
FROM_EMAIL=noreply@yourapp.com

# Application URLs
PASSWORD_RESET_URL=https://yourapp.com/reset-password

# CORS Configuration (SDT1-56: Hardened CORS)
# Single URL or comma-separated list of allowed origins
FRONTEND_URL=http://localhost:3000
# Set to 'true' to allow wildcard '*' in production (not recommended)
# ALLOW_CORS_WILDCARD=false
# Environment: development or production
# ENVIRONMENT=production

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Jira Configuration
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=SDT1

# Logging
LOG_LEVEL=INFO
