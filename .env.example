# Environment
ENVIRONMENT=development  # or 'production'

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# JWT Configuration (SDT1-63: Hardened JWT secret key handling)
# Generate a secure secret with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
# REQUIRED in production, optional in development (auto-generated if not set)
JWT_SECRET=your-secure-random-jwt-secret-at-least-32-characters
JWT_EXPIRY_HOURS=24
JWT_ALGORITHM=HS256

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
FROM_EMAIL=noreply@yourapp.com

# Application URLs
PASSWORD_RESET_URL=https://yourapp.com/reset-password
FRONTEND_URL=http://localhost:3000

# Security Settings
# WARNING: Only use these in development/testing, never in production!
# ALLOW_INSECURE_JWT_SECRET=false  # Set to 'true' to bypass JWT secret validation (NOT RECOMMENDED)
# ALLOW_CORS_WILDCARD=false        # Set to 'true' to allow CORS wildcard '*' (NOT RECOMMENDED)
