# UAT Backend Environment Variables
# Copy this file to .env and fill in your values

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Frontend Configuration (CORS)
# Single origin:
FRONTEND_URL=http://localhost:3000
# Multiple origins (comma-separated):
# FRONTEND_URL=http://localhost:3000,https://staging.example.com,https://app.example.com
# Wildcard (INSECURE - development only):
# FRONTEND_URL=*
# Leave empty to block all cross-origin requests (most secure)

# Rate Limiting Configuration
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_STORAGE_URI=memory://
# For production, use Redis:
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379

# Logging Configuration
LOG_LEVEL=INFO

# JWT Configuration
JWT_SECRET=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# SMTP Email Configuration (for password reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=SynPro Virtual Dev Team
