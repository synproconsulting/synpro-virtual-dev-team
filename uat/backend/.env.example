# UAT Backend Environment Variables
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env to version control!

# ── Environment ───────────────────────────────────────────────────────────────────────
# Set to 'development' or 'production' (default: production)
# Affects CORS and JWT validation strictness
ENVIRONMENT=development

# ── Database Configuration ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ── Frontend Configuration (CORS) ─────────────────────────────────────────────────────
# SDT1-56: Hardened CORS configuration
# Single frontend URL
FRONTEND_URL=http://localhost:3000

# Multiple frontend URLs (comma-separated)
# FRONTEND_URL=https://app.example.com,https://admin.example.com,https://staging.example.com

# Development wildcard (NOT RECOMMENDED for production)
# FRONTEND_URL=*
# ALLOW_CORS_WILDCARD=true

# ── JWT Configuration ─────────────────────────────────────────────────────────────────
# SDT1-63: Hardened JWT secret key handling
# 
# SECURITY: Generate a secure secret using:
#   python generate_jwt_secret.py
#
# Production: MUST be set to a cryptographically secure value (min 32 chars, 64 bytes recommended)
# Development: Optional (auto-generated if missing, but tokens won't persist across restarts)
#
# DO NOT use the example value below in production!
JWT_SECRET=your-secret-key-here-change-in-production

# Token expiry time in hours (default: 24)
JWT_EXPIRY_HOURS=24

# Allow weak JWT secrets in development (not recommended)
# Only set this to 'true' if you understand the security implications
# ALLOW_WEAK_JWT_SECRET=false

# ── Rate Limiting Configuration ───────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_STORAGE_URI=memory://
# For production, use Redis:
# RATE_LIMIT_STORAGE_URI=redis://localhost:6379

# ── Logging Configuration ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── SMTP Email Configuration ──────────────────────────────────────────────────────────
# For password reset emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=SynPro Virtual Dev Team

# ════════════════════════════════════════════════════════════════════════════════════
# Security Checklist (before deploying to production):
# ════════════════════════════════════════════════════════════════════════════════════
# 
# [ ] ENVIRONMENT is set to "production"
# [ ] JWT_SECRET is set to a cryptographically secure value (use generate_jwt_secret.py)
# [ ] FRONTEND_URL is set to specific domain(s), not "*"
# [ ] DATABASE_URL uses strong credentials
# [ ] SMTP credentials are valid and secure
# [ ] This file (.env) is in .gitignore and NOT committed
# [ ] All team members know to keep secrets confidential
# [ ] Secret rotation schedule is established (every 90 days recommended)
#
# For more information, see:
#   - docs/JWT_SECURITY.md (JWT configuration)
#   - tests/test_config.py (CORS configuration)
